{
  "goal": "Build running volume to 75 miles a week and hold it, keeping bike and swim volume in every week.",
  "targetMpw": 75,
  "targetDate": "",
  "rationale": "Seeded from the twelve-month plan document, which assumes a start near 28 miles a week coming off a knee injury. Running mileage is deliberately flat through the whole second phase and cycling peaks in the middle of the year rather than the end: both look like mistakes on paper and are the reason the plan works. These week targets are a placeholder until a Strava pull shows where the volume actually is, then rebuild the plan from that.",
  "phases": [
    {
      "n": 1,
      "name": "Rebuild",
      "weekFrom": 1,
      "weekTo": 13,
      "job": "Get back to volume you already know you can hold, and prove the knee tolerates it. This phase is about tissue, not fitness."
    },
    {
      "n": 2,
      "name": "Consolidate",
      "weekFrom": 14,
      "weekTo": 26,
      "job": "Hold the low fifties for three months without incident. Durability is built by repetition at a load, not by arriving at it."
    },
    {
      "n": 3,
      "name": "Build",
      "weekFrom": 27,
      "weekTo": 39,
      "job": "Add running volume into the aerobic base built on the bike, and start training the specific quality long events need: running tired."
    },
    {
      "n": 4,
      "name": "Peak",
      "weekFrom": 40,
      "weekTo": 52,
      "job": "Reach the top of the range and hold it briefly. Peak is a ceiling touched once, not a level to live at."
    }
  ],
