# Volume Ledger configuration. Copy to .env and fill in what you need.
# Nothing here is required to start the server.

# --- where the app runs ---------------------------------------------------
PORT=4317
HOST=127.0.0.1
# Must match the redirect URIs you register with Google and Strava.
BASE_URL=http://localhost:4317

# --- Google sign-in (optional) --------------------------------------------
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Authorized redirect URI:
#   http://localhost:4317/auth/google/callback
# Leave both blank to use the local single-user account instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Strava (required to sync training) -----------------------------------
# strava.com/settings/api -> create an application.
# Authorization Callback Domain: localhost
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# --- Claude ---------------------------------------------------------------
# Optional. If unset, the SDK still picks up an `ant auth login` profile on
# this machine, and each signed-in user can paste their own key in Setup.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=high
# Set to 0 to stop users supplying their own API keys.
ALLOW_USER_KEYS=1

# --- security -------------------------------------------------------------
# Encrypts stored OAuth tokens. Generated into data/.app-secret on first run;
# set it explicitly before running more than one instance.
APP_SECRET=
