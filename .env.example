# Chaos Coaching — server configuration.
# Copy to .env and fill in. Nothing here is committed; .env is ignored.

# --- where it lives ---------------------------------------------------------
# The public address, exactly as a browser sees it. Every OAuth callback is
# built from this, so it must match what Google and Strava have on file.
BASE_URL=https://coach.example.com
PORT=4317
HOST=127.0.0.1                 # behind Caddy/nginx keep this on loopback; 0.0.0.0 inside Docker
NODE_ENV=production

# --- secrets ----------------------------------------------------------------
# Encrypts Strava tokens at rest and derives the webhook verify token.
# Generate once, keep forever:  openssl rand -hex 32
# Losing it means every athlete reconnects Strava; that is all it means.
APP_SECRET=

# --- the coach ---------------------------------------------------------------
# The server pays for every account's coaching. The plan decides the model.
ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_FALLBACKS=0           # turn off server-side refusal fallbacks

# --- accounts ----------------------------------------------------------------
# Your account: Expert, never metered.
OWNER_EMAIL=you@gmail.com
# While the door is closed, only these may create an account. Empty = open.
ALLOWED_EMAILS=tester1@gmail.com,tester2@gmail.com

# --- Google sign-in ----------------------------------------------------------
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client (Web)
#   Authorised redirect URI:  {BASE_URL}/auth/google/callback
# Keep the consent screen in "Testing" and add each tester as a test user.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Strava ------------------------------------------------------------------
# strava.com/settings/api
#   Authorization Callback Domain:  coach.example.com   (host only, no scheme)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# STRAVA_VERIFY_TOKEN=         # optional; derived from APP_SECRET when unset

# --- data --------------------------------------------------------------------
# DB_PATH=/data/ledger.db      # inside Docker the volume mounts at /data
